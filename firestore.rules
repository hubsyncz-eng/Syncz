rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /agencies/{agencyId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(agencyId);
    }

    match /partners/{partnerId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(partnerId);
    }

    match /consultants/{consultantId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(consultantId);
    }

    match /slots/{slotId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(slotId);
    }

    match /bookings/{bookingId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(bookingId);
    }

    match /activities/{activityId} {
      allow list: if true;
      allow get, create, update, delete: if isValidId(activityId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
